{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/components/**/*.vue"
  ],
  "exclude": [
    "src/main.ts",
    "src/plugins/**",
    "src/router/**",
    "src/pages/**"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": ["node", "vitest/globals"]
  }
}
